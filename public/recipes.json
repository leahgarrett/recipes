    {
      "id": "2",
      "name": "Classic Margherita Pizza",
      "servings": 4,
      "prepTime": "2 hours",
      "cookTime": "15 minutes",
      "category": "Dinner",
      "description": "Traditional Italian pizza with fresh tomatoes, mozzarella, and basil",
      "photos": [
        {
          "url": "https://via.placeholder.com/600x400/FFE4C4/8B0000?text=Margherita+Pizza",
          "alt": "Classic Margherita pizza with melted mozzarella and fresh basil",
          "caption": "Traditional Margherita pizza"
        }
      ],
      "ingredients": [
        {
          "item": "bread flour",
          "amount": 3,
          "unit": "cups"
        },
        {
          "item": "warm water",
          "amount": 1.25,
          "unit": "cups"
        },
        {
          "item": "active dry yeast",
          "amount": 2.25,
          "unit": "teaspoons"
        },
        {
          "item": "olive oil",
          "amount": 2,
          "unit": "tablespoons"
        },
        {
          "item": "salt",
          "amount": 1.5,
          "unit": "teaspoons"
        },
        {
          "item": "sugar",
          "amount": 1,
          "unit": "teaspoon"
        },
        {
          "item": "crushed tomatoes",
          "amount": 1,
          "unit": "cup"
        },
        {
          "item": "fresh mozzarella cheese",
          "amount": 16,
          "unit": "oz"
        },
        {
          "item": "fresh basil leaves",
          "amount": 1,
          "unit": "cup"
        }
      ],
      "instructions": [
        {
          "instruction": "Mix warm water, yeast, and sugar. Let stand 5 minutes until foamy.",
          "type": "mix"
        },
        {
          "instruction": "Add flour, olive oil, and salt. Knead for 10 minutes until smooth and elastic.",
          "type": "other"
        },
        {
          "instruction": "Place in oiled bowl, cover, and let rise for 1.5 hours until doubled.",
          "type": "rest"
        },
        {
          "instruction": "Divide dough into 2 portions. Roll each into a 12-inch circle.",
          "type": "other"
        },
        {
          "instruction": "Spread crushed tomatoes over dough, leaving a 1-inch border.",
          "type": "other"
        },
        {
          "instruction": "Tear mozzarella and distribute evenly over sauce.",
          "type": "other"
        },
        {
          "instruction": "Bake at 475°F (245°C) for 12-15 minutes until crust is golden.",
          "type": "bake"
        },
        {
          "instruction": "Remove from oven and top with fresh basil leaves. Serve immediately.",
          "type": "bake"
        }
      ]
    },
